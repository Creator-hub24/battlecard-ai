# Copy to .env and fill in. Every key is optional: with no keys the agent runs fully offline.

# Gemini analysis (https://aistudio.google.com/apikey). If unset, the offline heuristic analyzer is used.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest, set in competitors.yaml)
GEMINI_MODEL=

# Optional: Firecrawl for JS-heavy pages in --live mode. If unset, requests + BeautifulSoup are used.
FIRECRAWL_API_KEY=
